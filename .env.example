# Disabled until every launch check in docs/reservations-operations.md is complete.
HALO_RESERVATIONS_ENABLED=false
HALO_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# A TLS-enabled PostgreSQL connection URL from your database provider in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate locally with openssl rand -hex 32; never commit a real value.
RESERVATION_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
